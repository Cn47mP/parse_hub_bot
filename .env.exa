##### Bot 配置 #####
API_HASH=
API_ID=
BOT_TOKEN=
# 海外服务器无需填写
# BOT_PROXY=http://127.0.0.1:7890
# 使用 IPv6 连接 Telegram (IPv6-only 服务器需开启)
# BOT_IPV6=false
# Bot 管理员 ID, 逗号分隔, 可在私聊使用 /admin 管理平台配置
# ADMIN_IDS=123456789,987654321
# 白名单用户 ID, 逗号分隔; 空列表=不限制
# ALLOWED_USERS=123456789,987654321

##### 缓存配置 #####
# 缓存最大条数, 0 为不限制
# CACHE_MAX_ENTRIES=30000
# 禁用缓存
# CACHE_DISABLED=false

##### 并发与转码 #####
# 最大并发处理条数(同时下载/转码/上传), 限制 downloads 磁盘峰值
# MAX_CONCURRENT_DOWNLOADS=8
# 发送前强制转码为可流式播放的 H.264 MP4; 关闭则退回旧行为
# AUTOPLAY_SAFE_TRANSCODE=true
# 超过该时长(秒)且无硬件编码时跳过转码直发
# AUTOPLAY_SKIP_TRANSCODE_MAX_DURATION=600
# 超过该体积(字节)且无硬件编码时跳过转码直发
# AUTOPLAY_SKIP_TRANSCODE_MAX_SIZE=524288000

##### 速率限制 #####
# 启用解析速率限制
# RATE_LIMIT_ENABLED=false
# 突发请求阈值, 0 为不限制
# RATE_LIMIT_BURST=5
# 突发请求统计窗口, 单位秒
# RATE_LIMIT_BURST_WINDOW=60
# 触发限速后的冷却时间, 单位秒
# RATE_LIMIT_COOLDOWN=180
# 冷却期内允许解析次数, 0 为禁止解析
# RATE_LIMIT_THROTTLE=1
# 冷却期内允许解析次数对应的统计窗口, 单位秒
# RATE_LIMIT_THROTTLE_WINDOW=5
